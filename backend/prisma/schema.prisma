generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String
  name       String
  role       Role        @default(CUSTOMER)
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  address1   String?
  birthDate  String?
  country    String?
  location   String?
  postalCode String?
  username   String?
  weight     String?
  blocked    Boolean     @default(false)
  bookings   Booking[]
  Comment    Comment[]
  invoices   Invoice[]
  Organizer  Organizer[]
}

model Category {
  id          String     @id @default(uuid())
  title       String
  alias       String     @unique
  description String?    @db.Text
  imageUrl    String?
  parentId    String?
  status      String     @default("PUBLISHED")
  accessLevel String     @default("PUBLIC")
  tags        String?
  note        String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  events      Event[]
}

model Event {
  id                   String        @id @default(uuid())
  title                String
  category             String?
  description          String?       @db.Text
  startDate            DateTime
  endDate              DateTime?
  location             String?       @db.Text
  capacity             Int           @default(20)
  color                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  imageUrl             String?
  maxParticipants      Int?
  organizer            String?       @default("Flugschule Hirondelle")
  registrationDeadline DateTime?
  categoryId           String?
  alias                String?       @unique
  bookableFor          String?       @default("public")
  bookingType          String?       @default("limited")
  currency             String?       @default("EUR")
  eventType            String?       @default("paid")
  feePerPerson         Float?        @default(0)
  googleMapsAddress    String?       @db.Text
  isHotEvent           Boolean       @default(false)
  isTopEvent           Boolean       @default(false)
  leadSpeaker          String?
  locationType         String?       @default("custom")
  maxBookablePerPerson Int?          @default(1)
  metaDescription      String?       @db.Text
  metaKeywords         String?       @db.Text
  minParticipants      Int?          @default(0)
  onExceed             String?       @default("waitlist")
  paymentProcessing    Boolean       @default(true)
  published            Boolean       @default(true)
  shortDescription     String?       @db.Text
  tags                 String?
  targetGroup          String?       @db.Text
  taxRate              String?
  tieredFees           Boolean       @default(false)
  calendarBgColor      String?       @default("#3a87ac")
  calendarTextColor    String?       @default("#ffffff")
  customBookingEmail   String?
  customCertificate    String?
  eventNumber          String?
  // Old site's Matukio "Nummer" field (hiron_matukio_recurring.semnum) -
  // a site-wide per-year running counter assigned when the date was
  // created, shown as-is ("5/26") in the old site's Informationen box.
  // Purely a stored label, not derived from capacity/bookings.
  bookingNumber        String?
  titleOverride        String?
  organizerId          String?
  locationId           String?
  eventTieredFees      Json?
  // Old Matukio's "Additional Selectable Fee Options" (extra_fee_options) -
  // genuine flat-price bolt-on add-ons (e.g. a hotel room) a customer can
  // opt into on top of whichever ticket they picked. Distinct from
  // `tickets` (the actual ticket types themselves) and from
  // `eventTieredFees` (a checkout-time discount/surcharge on the base
  // fee) - {title, value, perPlace}[].
  extraFeeOptions      Json?
  // Values entered for this event's category's CustomField definitions -
  // {[customFieldId]: value}. The CustomField model only stores the field
  // DEFINITION (title, type, which categories it applies to); this is
  // where a specific event's actual answer lives.
  customFieldValues    Json?
  // Old site's separate "detail view" image (content.php:184), shown on
  // the full event page - distinct from imageUrl (listing/overview
  // cards). The equivalent "detail view" DESCRIPTION field already exists
  // above as plain `description` (migrated from old's own `description`
  // column, distinct from `shortDescription` which came from old's
  // `shortdesc`) - it was just never exposed on the admin form until now,
  // no new field needed for that half.
  detailImageUrl       String?
  // Old Matukio's hiron_matukio_recurring.hits page-view counter - real,
  // actively-used data on the old site (not the near-never-used
  // grade/rating column, which we deliberately did not migrate/rebuild).
  views                Int           @default(0)
  seriesId             String?       // groups every date-occurrence generated together (single add or batch-recurring)
  cancelled            Boolean       @default(false) // distinct from `published` - a cancelled date stays visible but not bookable
  // Old Matukio's allday/showbegin/showend/showbooked toggles
  // (administrator/components/com_matukio/models/events.php) - let an
  // admin hide a specific time-of-day for a multi-day/all-day event (e.g.
  // a week-long tour) where showing one arbitrary hour looks wrong, or
  // hide the registration-deadline line entirely for an event that has
  // none worth mentioning. Purely display toggles - booking eligibility
  // logic (registrationDeadline, capacity) is unaffected either way.
  allDay                   Boolean @default(false)
  showStartTime            Boolean @default(true)
  showEndTime              Boolean @default(true)
  showRegistrationDeadline Boolean @default(true)
  // New (no old Matukio equivalent - checked administrator/components/
  // com_matukio for any "additional day" concept, none found) - lets an
  // admin attach extra, non-contiguous day/time entries to a single
  // recurring date (e.g. a course meeting Mon 9-12 AND Wed 14-17 under one
  // booking entry) beyond its own single startDate/endDate range. Array of
  // {date, startTime, endTime}, display-only (doesn't affect booking
  // eligibility/capacity logic).
  additionalDays       Json?
  bookings             Booking[]
  Comment              Comment[]
  categoryRef          Category?     @relation(fields: [categoryId], references: [id])
  Location             Location?     @relation(fields: [locationId], references: [id])
  Organizer            Organizer?    @relation(fields: [organizerId], references: [id])
  tickets              EventTicket[]
  Voucher              Voucher[]
  files                EventFile[]

  @@index([seriesId])
}

// Old Matukio's per-event file attachments (edit/files.php) - a title +
// uploaded file + access level. Real historical usage on the old site was
// minimal (a single PDF across its whole history), so this stays a plain
// upload/list/delete list rather than a heavier ACL/download-tracking
// system old's Joomla component also had.
model EventFile {
  id        String   @id @default(uuid())
  eventId   String
  title     String
  url       String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventTicket {
  id          String        @id @default(uuid())
  eventId     String
  name        String
  price       Float
  description String?       @db.Text
  capacity    Int           @default(20)
  // Old Matukio's booking-form dropdown always lists "Normal" (the base
  // fee) first, then each different_fees_override entry in the order the
  // admin originally entered them (feetype.php builds its <option> list in
  // exactly that sequence). The id column here is a random UUID, so without
  // its own explicit sort column, ticket display order was whatever MySQL
  // happened to return - effectively random, not matching old at all.
  order       Int           @default(0)
  items       BookingItem[]
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String        @id @default(uuid())
  userId          String?
  eventId         String
  status          BookingStatus @default(PENDING)
  totalPrice      Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customerDetails Json?
  paymentMethod   String?
  remarks         String?       @db.Text
  rating          Int?
  ratingComment   String?       @db.Text
  paid            Boolean       @default(false)
  certificated    Boolean       @default(false)
  checkedIn       Boolean       @default(false)
  adminComment    String?       @db.Text // internal admin-only note, distinct from customer-facing `remarks`
  // Set the first (and only) time reminders.job.ts's daily cron actually
  // sends each email for this booking - the cron re-queries "events in
  // exactly 3 days" / "events that ended yesterday" fresh every run with no
  // memory of what it already sent, so without these guards a duplicate
  // cron execution (e.g. a stray zombie process from a dev-server restart
  // that never fully died) resends the same email every time it fires.
  reminderSentAt       DateTime?
  ratingRequestSentAt  DateTime?
  // Old Matukio's matukio_bookings.payment_netto/_tax/_brutto - frozen at
  // booking time from the event's taxRate as it existed THEN, so a later
  // change to that rate (or to the TaxRate table) can never rewrite what a
  // past booking's invoice actually showed. `totalPrice` remains the
  // brutto/gross total; these two let it be split back out. Null for
  // free bookings or events with no tax rate configured - never a real
  // 0/0 split in that case, so callers must check for null before
  // treating netto+tax as authoritative.
  priceNet             Float?
  priceTax             Float?
  priceTaxRatePercent  Float?
  // Old Matukio stored the redeemed coupon on the booking row itself
  // (matukio_bookings.coupon_used), not just inside a free-form JSON blob
  // - needed so "who used code X" can be a plain indexed query instead of
  // scanning every booking's customerDetails. Still also duplicated into
  // customerDetails.appliedVoucher (see bookings.routes.ts) for whatever
  // already reads it from there; this is the authoritative copy.
  voucherCode          String?
  // Old Matukio's matukio_bookings.payment_plugin_data - the raw gateway
  // response, kept for dispute/refund troubleshooting on bookings paid
  // while PayPal was still integrated. PayPal has since been removed, so
  // this is historical-only now and never populated for new bookings.
  paymentGatewayResponse Json?
  event           Event         @relation(fields: [eventId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  items           BookingItem[]
  invoiceNumber   InvoiceNumber?
}

model BookingItem {
  id        String      @id @default(uuid())
  bookingId String
  ticketId  String
  quantity  Int         @default(1)
  booking   Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticket    EventTicket @relation(fields: [ticketId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Newsletter {
  id           String   @id @default(uuid())
  email        String
  name         String?
  isActive     Boolean  @default(true)
  isConfirmed  Boolean  @default(true)
  subscribedAt DateTime @default(now())
  listType     String   @default("GENERAL") // Kept for legacy support or to store the code
  language     String   @default("German")
  trackStatus  Boolean  @default(true)
  confirmToken String?  @unique // used for double opt-in confirmation links
  // Optional free-text feedback captured on the public unsubscribe page
  // (Abmelden.tsx) - old AcyMailing tracked this in hiron_acym_history and
  // real customers left genuine complaints/reasons there, which had no
  // equivalent field to land in here at all.
  unsubscribeReason String? @db.Text
  // Old AcyMailing's acymailing_fields - admin-definable extra subscriber
  // data (phone, interests, birthday, ...), answers stored per-subscriber
  // as {[NewsletterFieldDefinition.id]: value}. The field DEFINITIONS
  // themselves live in NewsletterFieldDefinition below, same split as the
  // existing CustomField (definition) / Event.customFieldValues (answer)
  // pattern already used for events.
  customFields Json?
  // Old AcyMailing's acymailing_tag/tagmail - simple comma-separated tag
  // list rather than a full join table (matches CustomField.categoryIds'
  // own comma-separated convention elsewhere in this schema), since real
  // usage here is "a handful of freeform labels", not a large controlled
  // vocabulary needing referential integrity.
  tags String?

  // Old AcyMailing's real hiron_acym_user.source - where this subscriber
  // actually came from (e.g. "frontend" for a self-service signup form,
  // "backend" for an admin manually adding someone, "import" for a CSV
  // import). Shown on EditSubscriber.tsx instead of a fake hardcoded
  // "System" placeholder.
  source String?

  // Old AcyMailing's real IMAP-mailbox-polling bounce handling (task: real
  // bounce handling) - a hard-bounced address is suppressed from future
  // sends (see getTargetSubscribers/resolveSegmentRecipients, both already
  // filter on isActive) without deleting the row, so the admin can still see
  // why a subscriber stopped receiving mail.
  bounced      Boolean   @default(false)
  bounceReason String?   @db.Text
  bouncedAt    DateTime?

  @@unique([email, listType])
}

// Old AcyMailing's acymailing_fields table - see Newsletter.customFields'
// own comment for the definition/answer split.
model NewsletterFieldDefinition {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  fieldType  String   @default("text") // text | textarea | select | checkbox | date
  options    String?  @db.Text // for "select": one choice per line
  required   Boolean  @default(false)
  showOnForm Boolean  @default(true) // visible on the public subscribe form, not just the admin editor
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NewsletterList {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique // matches Newsletter.listType, e.g. "GENERAL"
  description String?
  color       String?  @default("#0ea5e9")
  visible     Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Old AcyMailing's acymailing_list.welmailid/unsubmailid - autoresponder
  // mails fired at subscribe/unsubscribe time, per list (a "Tandemflüge
  // Newsletter" subscriber gets a different welcome mail than a general
  // one). Null subject = that autoresponder is off for this list; see
  // newsletters.routes.ts's confirm/unsubscribe handlers for where these
  // actually get sent.
  welcomeSubject String?
  welcomeBody    String? @db.LongText
  goodbyeSubject String?
  goodbyeBody    String? @db.LongText
  // Old AcyMailing's real per-list "tracking" toggle - opens/clicks are only
  // recorded for a campaign send if BOTH the campaign itself and the
  // recipient's list have tracking enabled (see newsletterQueueProcessor.ts).
  tracking Boolean @default(true)
}

model AdBanner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  String   @default("home_top")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingFormConfig {
  id        String   @id @default("default")
  steps     Json
  updatedAt DateTime @updatedAt
}

model Comment {
  id            String    @id @default(uuid())
  eventId       String?
  userId        String?
  name          String?
  // BUG FIX: this was `@unique`, which - since a UNIQUE index treats every
  // non-null value as globally distinct - meant the SAME real person could
  // never leave a second comment anywhere on the entire site with the same
  // email address (the second insert would throw and 500). Never triggered
  // via the real public comment form only because that form never actually
  // collected an email at all until now - see EventComments.tsx.
  email         String?
  content       String    @db.Text
  isApproved    Boolean   @default(false)
  parentId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pageSlug      String?
  // Old's real CComment columns (view=comments) this app never had at all.
  ip            String?
  votesUp       Int       @default(0)
  votesDown     Int       @default(0)
  Event         Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Comment       Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  other_Comment Comment[] @relation("CommentToComment")
  user          User?     @relation(fields: [userId], references: [id])
}

// Old's real CComment "Einstellungen" (view=settings) - deep-verified
// against settings.xml. Threading/sort/comments-per-page/BBCode/pictures/
// per-category-enable/Akismet/reCAPTCHA are either already handled
// elsewhere in this app's own way (real threading via parentId already
// exists) or are settings-only here (no BBCode editor / captcha
// infrastructure exists yet, same "store the toggle, don't fake the
// feature" precedent as Visforms' Spamschutz tab).
model CommentSettings {
  id               String   @id
  // Matches old's real live hiron_comment_setting row (auto_publish="1",
  // notify_moderators="0") - a deep DB audit found the defaults here had
  // been flipped from old's actual configured values.
  autoPublish      Boolean  @default(true)
  notifyModerators Boolean  @default(false)
  moderatorEmail   String?
  notifyOnReply    Boolean  @default(true)
  maxLength        Int      @default(30000)
  // Old's real live values: sort="0" (oldest-first) and comments_per_page="0"
  // (unlimited) - previously defaulted to newest-first/20 here, AND never
  // actually applied anywhere (see comments.routes.ts's /public route fix).
  sortOrder        String   @default("oldest") // 'newest' | 'oldest'
  commentsPerPage  Int      @default(0) // 0 = unlimited, matches old
  showGravatar     Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// Old's real "E-Mail-Warteschlange" (view=emailqueues) - a visible log of
// every notification email a comment triggered (new-comment-to-moderators,
// reply-to-original-commenter), not just a fire-and-forget send, matching
// old's real Von/Gesendet-von/Gesendet-an/Betreff/Inhalt/Typ/Status columns.
model CommentEmailQueue {
  id        String   @id @default(uuid())
  commentId String?
  fromEmail String?
  fromName  String?
  toEmail   String
  subject   String
  body      String   @db.Text
  type      String // 'moderator_notification' | 'reply_notification'
  status    String   @default("pending") // 'sent' | 'failed'
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

model Currency {
  id             String   @id @default(uuid())
  description    String
  symbol         String
  paymentCode    String
  symbolPosition String   @default("Rechts")
  decimalChar    String   @default(",")
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomField {
  id           String   @id @default(uuid())
  title        String
  position     String?  @default("Veranstaltungsuebersicht")
  slug         String   @unique
  whenToShow   String   @default("all")
  categoryIds  String?
  fieldType    String   @default("text")
  options      String?  @db.Text
  defaultValue String?  @db.Text
  allowEmpty   Boolean  @default(false)
  addFilter    Boolean  @default(false)
  showLabel    Boolean  @default(true)
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DownloadCategory {
  id           String         @id @default(uuid())
  title        String
  description  String?        @db.Text
  published    Boolean        @default(true)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  DownloadFile DownloadFile[]
}

model DownloadFile {
  id               String           @id @default(uuid())
  categoryId       String
  title            String
  description      String?          @db.Text
  fileUrl          String
  fileSize         Int?
  published        Boolean          @default(true)
  order            Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  DownloadCategory DownloadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model EcwidConfig {
  id                            String   @id @default("default")
  storeId                       String   @default("35710010")
  displaySearchBoxAboveProducts Boolean  @default(true)
  displayHorizontalCategories   Boolean  @default(true)
  productsPerRowGrid            Int      @default(3)
  productsPerPageGrid           Int      @default(20)
  seoFriendlyUrls               Boolean  @default(true)
  categoryShownByDefault        String   @default("Store root category")
  customerSingleSignOn          Boolean  @default(false)
  updatedAt                     DateTime @updatedAt
}

model Location {
  id            String   @id @default(uuid())
  title         String
  name          String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?
  website       String?
  imageUrl      String?
  description   String?  @db.Text
  comments      String?  @db.Text
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Event         Event[]
}

model News {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterCampaign {
  id              String    @id @default(uuid())
  subject         String
  name            String?
  previewLine     String?
  body            String    @db.LongText
  status          String    @default("DRAFT")
  design          String?   @db.LongText // JSON string of the drag-and-drop design state
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  targetList      String    @default("GENERAL")
  recipientsCount Int       @default(0)
  opensCount      Int       @default(0)
  clicksCount     Int       @default(0)
  visible         Boolean   @default(true)
  fromName        String?
  fromEmail       String?
  replyToName     String?
  replyToEmail    String?
  attachments     String?   @db.Text
  keywords        String?   @db.Text
  bcc             String?
  bounceEmail     String?
  trackingEnabled Boolean   @default(true)
  // Old AcyMailing's mail.type ("news"/"autonews"/"welcome"/"notification"
  // etc.) - simplified to just the distinction that's actually useful in
  // the campaign list/reporting here: a regular one-off newsletter vs. an
  // autoresponder-generated send (welcome/goodbye, see NewsletterList
  // above) vs. a system notification. Purely a label, doesn't change
  // sending behavior on its own.
  type            String    @default("news") // news | autoresponder | notification
  // Old AcyMailing's real per-campaign custom CSS stylesheet override
  // (confirmed genuinely used on ~1% of real historical campaigns) -
  // injected into the sent email's <head> alongside the design's own
  // generated styles.
  customCss       String?   @db.Text
}

model NewsletterTemplate {
  id           String   @id @default(uuid())
  name         String
  body         String   @db.LongText
  design       String?  @db.LongText // JSON string of the drag-and-drop design state
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Old AcyMailing's template.category - lets the "Vorlage wählen" screen
  // group templates instead of one flat list once there are more than a
  // handful.
  category     String?  @default("Allgemein")
}

model NewsletterQueue {
  id              String   @id @default(uuid())
  campaignId      String
  subscriberEmail String
  status          String   @default("PENDING") // PENDING, PROCESSING, FAILED, SENT
  scheduledAt     DateTime
  sentAt          DateTime?
  errorLog        String?  @db.Text
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, scheduledAt])
}

model NewsletterTrackingEvent {
  id              String   @id @default(uuid())
  campaignId      String
  subscriberEmail String
  type            String   // OPEN or CLICK
  url             String?  // original destination, only set for CLICK
  createdAt       DateTime @default(now())
  // Old AcyMailing's userstats captured browser/browser_version/is_mobile/
  // user_agent per open (plus geolocation - deliberately NOT reproduced
  // here, since real geo-IP lookup needs a paid/rate-limited external
  // service this project has no credentials or budget decision for; ask
  // before adding one). Parsed from the request's own User-Agent header at
  // tracking time in track.routes.ts - no third-party call needed for this
  // part.
  userAgent String? @db.Text
  browser   String?
  isMobile  Boolean @default(false)

  @@index([campaignId, type])
  @@index([subscriberEmail])
}

// Old AcyMailing's real hiron_acym_history - a real per-subscriber
// subscribe/confirm/unsubscribe/bounce event log (old's "Aktivitätsverlauf"
// tab, view Users/tmpl/edit_history.php). Previously had no equivalent at
// all here - the admin tab was a permanent hardcoded "no data" stub.
model NewsletterHistory {
  id        String   @id @default(uuid())
  email     String
  action    String // 'subscribe' | 'confirm' | 'unsubscribe' | 'bounce'
  listType  String?
  reason    String?  @db.Text
  ip        String?
  source    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model NewsletterConfig {
  id        String   @id @default("default")
  smtpHost  String?
  smtpPort  String?
  smtpUser  String?
  smtpPass  String?
  fromEmail String?
  fromName  String?
  updatedAt DateTime @updatedAt

  // Warteschlange (Queue / sending rate)
  queueBatchSize    Int @default(50)  // emails sent per cron tick
  queuePauseSeconds Int @default(0)   // pause between individual sends, in seconds
  queueMaxRetries   Int @default(2)   // max retry attempts for a failed send

  // Abonnement (Subscription)
  // Matches old's real live hiron_acym_configuration value
  // (require_confirmation="1") - a deep DB audit found this had been left
  // off by default here, silently skipping the double-opt-in confirmation
  // email old's real production site actually sent to every new subscriber.
  requireConfirmation Boolean @default(true) // double opt-in
  unsubscribeTitle    String?
  unsubscribeColor    String  @default("#00a4ff")

  // Datenschutz (GDPR)
  gdprExportEnabled Boolean @default(true)
  gdprDeleteEnabled Boolean @default(true)

  // old: hiron_acym_configuration's social_icons - available for a
  // campaign's social-icons footer block. JSON string keyed by platform
  // (facebook/instagram/twitter/linkedin/youtube/pinterest/vimeo/
  // wordpress/x/telegram), each value the real profile URL or "" if the
  // business has no account on that platform.
  socialLinks String? @db.Text

  // Multi-provider mailer support - old's real dynamics/ folder ships
  // separate Mailgun/ElasticEmail/sendmail/qmail/phpmail "mailers" as
  // alternatives to plain SMTP. Every one of those (and every other real
  // transactional provider - SendGrid, Amazon SES, Brevo, IONOS, Gmail, ...)
  // also exposes a genuine SMTP relay endpoint, so this app's existing
  // generic SMTP transporter (newsletterTransporter.ts) already reaches all
  // of them - this field is purely a UI preset label (see NewsletterConfigPage's
  // provider dropdown) that prefills the right host/port for a chosen
  // provider; it never changes how a mail actually gets sent.
  mailerProvider String @default("custom")

  // Bounce-Verwaltung - old AcyMailing's real IMAP-mailbox-polling bounce
  // handling (MailboxHelper.php): a dedicated inbox that receives bounce
  // notifications is polled periodically; hard-bounce addresses get
  // suppressed (see Newsletter.bounced). Credentials are for a real mailbox
  // the admin's mail provider gives them for exactly this purpose (often the
  // same address campaigns' Return-Path already points bounces to).
  bounceCheckEnabled Boolean   @default(false)
  bounceImapHost     String?
  bounceImapPort     String?   @default("993")
  bounceImapUser     String?
  bounceImapPass     String?
  bounceImapTls      Boolean   @default(true)
  lastBounceCheckAt  DateTime?
}

// Dynamic subscriber filters (old AcyMailing's real Segments) - conditions
// are evaluated in resolveSegmentRecipients() rather than turned into a raw
// SQL WHERE, since some conditions (campaign open/click behavior) need a
// join against NewsletterTrackingEvent that's simplest expressed in code at
// this subscriber-list scale (a few thousand rows, not millions).
model NewsletterSegment {
  id         String   @id @default(uuid())
  name       String
  matchType  String   @default("all") // 'all' (AND) | 'any' (OR)
  conditions String   @db.Text // JSON array of {field, operator, value, fieldId?}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Trigger-based autoresponder sequences (old AcyMailing's real
// Automations/Scenarios) - a subscribe event starts a NewsletterAutomationRun
// per matching active automation; newsletterAutomation.job.ts's cron tick
// sends whichever run's current step is due and advances/completes it.
model NewsletterAutomation {
  id              String                    @id @default(uuid())
  name            String
  active          Boolean                   @default(true)
  triggerListCode String? // null = fires on subscribe to ANY list
  steps           String                    @db.Text // JSON array of {delayDays, subject, body}
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  runs            NewsletterAutomationRun[]
}

model NewsletterAutomationRun {
  id              String               @id @default(uuid())
  automationId    String
  subscriberEmail String
  currentStep     Int                  @default(0)
  nextSendAt      DateTime
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  automation      NewsletterAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([nextSendAt, completedAt])
}

// Subscription form builder (old AcyMailing's real Forms) - an admin-designed
