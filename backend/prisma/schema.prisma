// Old Matukio's real, live "Settings" admin page (JComponentHelper::
// getParams('com_matukio'), 165 total keys) had no equivalent anywhere in
// the new app - this covers the subset that was found to have a genuine,
// non-default, real-world effect on this site during a full admin audit
// (email notification toggles, the cancellation-deadline window, and the
// booking-rejection email's default subject line). The rest of old's 165
// keys were confirmed either dead/default (cron jobs all disabled, CSV
// export settings already hardcoded correctly matching real values) or
// already covered elsewhere (AGB legal text, PayPal credentials).
model SettingsConfig {
  id                         String   @id @default("default")
  // old: sendmail_teilnehmer - the customer's own booking-confirmation email
  sendmailTeilnehmer         Boolean  @default(true)
  // old: notify_participants_publish / notify_participants_cancel / notify_participants_delete
  notifyParticipantsPublish  Boolean  @default(true)
  notifyParticipantsCancel   Boolean  @default(true)
  notifyParticipantsDelete   Boolean  @default(true)
  // old: sendmail_owner - a copy of every new booking to the school itself
  sendmailOwner              Boolean  @default(false)
  ownerNotificationEmail     String?
  // old: sendmail_invoice / sendmail_ticket / sendmail_certificate - whether
  // the confirmation email actually attaches these PDFs
  sendmailInvoice            Boolean  @default(true)
  sendmailTicket             Boolean  @default(true)
  sendmailCertificate        Boolean  @default(false)
  // old: booking_stornotage - cancellation/payment-deadline window, in days
  bookingStornotage          Int      @default(28)
  // old: rejection_subject - default subject line for the admin's
  // booking-rejection email compose dialog
  rejectionSubject           String   @default("Ihre Buchungsanfrage")
  // old: sendmail_newevent_group - notify registered customers when a
  // genuinely new event is created (real, active setting on the live
  // site - unlike cron_freeplaces_reminder, which is off there and has no
  // send-path implemented here either, for the same reason).
  sendmailNewEventGroup      Boolean  @default(true)
  // old: sendmail_operator ("Email BCC") - real, on by default when set
  // (an admin address that gets a copy of every outgoing booking-related
  // email), unlike the cron_confirmationcheck/cron_freeplaces_reminder/
  // cron_invoice_afterevent trio (all default OFF in old's own config.xml,
  // no evidence this site ever turned them on - correctly not built here).
  emailBcc                   String?
  // New (not from old) - a WordPress-style "Coming soon" gate: while
  // enabled, every public-facing page shows a branded password page
  // instead of the real site (admin and the API itself stay reachable so
  // the team can keep testing/managing content). See
  // middlewares/maintenanceGate.middleware.ts.
  maintenanceModeEnabled     Boolean  @default(false)
  maintenancePassword        String?
  updatedAt                  DateTime @updatedAt
}

model CookieConsentConfig {
  id                  String   @id @default("default")
  enabled             Boolean  @default(true)
  title               String   @default("Hinweis zum Datenschutz")
  bodyText            String   @db.Text
  privacyLinkText     String?  @default("Lesen Sie unsere Datenschutzrichtlinie.")
  privacyLinkUrl      String?  @default("/datenschutz")
  acceptButtonText    String   @default("Akzeptieren")
  declineButtonText   String   @default("Ablehnen")
  settingsButtonText  String   @default("Cookie-Einstellungen")
  settingsUrl         String?
  updatedAt           DateTime @updatedAt
}

// Same idea as HomeContent below, generalized to the other main-nav
// landing pages (Ausbildung, Performance, Reisen, Service, Infos) that
// already have a hand-built React/Tailwind layout: only the TEXT/IMAGES are
// admin-editable, never the layout. One shared table instead of 5 near-
// identical ones - `id` is the page's own slug ('ausbildung', 'performance',
// 'reisen', 'service', 'infos') and `data` holds that page's own JSON shape,
// which only sitePageContent.routes.ts's per-page defaults and each page's
// own admin editor (e.g. AusbildungContentEditor.tsx) need to agree on.
model SitePageContent {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Makes the DATA on the (hardcoded, Tailwind-styled) home page editable -
// promo card text, the "Hoch Hinaus" copy, team member names/photos -
// without touching the page's actual layout/design. Deliberately not part
// of the Seiten/Unlayer CMS (Page model / pages.routes.ts): that system is
// for admin-authored pages that don't have a pre-built React layout, and
// letting an admin rebuild the home page's design there proved to be the
// wrong tool for a page whose look must never change - see Home.tsx, which
// reads this via GET /api/homecontent/public and falls back to its own
// hardcoded copy if this row doesn't exist yet.
model HomeContent {
  id                        String   @id @default("default")
  promoCards                Json // [{ title, boldLine, description, image, link }] - fixed length 3
  teamMembers               Json // [{ name, image }] - fixed length 5 (Alex, Sarah, Tobi, Holger, Markus)
  teamLink                  String   @default("/infos/team") // where all 5 team photos link to
  hochHinausHtml            String   @db.LongText // rich text, keeps the "Team Hirondelle" link
  newsEyebrow               String   @default("AKTUELLES")
  newsTitle                 String   @default("NEWS")
  hochHinausEyebrowPrefix   String   @default("...mit dem")
  hochHinausEyebrowLinkText String   @default("Team Hirondelle")
  hochHinausTitle           String   @default("HOCH HINAUS")
  updatedAt                 DateTime @updatedAt
}

// WordPress-style Trash: a "Löschen" click on any page (a custom Page/
// Unlayer row, or a "reset" of one of the 6 fixed pages' HomeContent/
// SitePageContent row) snapshots the deleted row here instead of actually
// destroying it, so it can be restored. `kind` says which table it came
// from ('page' | 'homecontent' | 'sitepagecontent'), `refId` is that row's
// original id, and `data` is everything needed to recreate it - see
// trash.routes.ts for the restore logic, and pages.routes.ts /
// homecontent.routes.ts / sitePageContent.routes.ts for what snapshots in
// on delete. Never queried by the public site - admin (Papierkorb) only.
model ContentTrash {
  id        String   @id @default(uuid())
  kind      String
  refId     String
  title     String
  data      Json
  deletedAt DateTime @default(now())
}

// A TRUE same-design duplicate of one of the 6 fixed pages (Startseite/
// Ausbildung/Performance/Reisen/Service/Infos) at a new URL: `kind` says
// which hardcoded React component to render (Ausbildung.tsx etc. - see
// FixedPageRouter.tsx), and `slug` is a normal SitePageContent row (id =
// this row's own `slug`) holding a COPY of that component's data. Because
// it's rendered by the exact same component as the original, the design is
// pixel-identical - unlike a duplicate into the Seiten/Unlayer CMS (Page
// model), which can only ever approximate the layout with generic blocks.
// See fixedPageDuplicates.routes.ts.
model FixedPageDuplicate {
  id        String   @id @default(uuid())
  slug      String   @unique
  kind      String
  title     String
  status    String   @default("published") // "published" | "draft" - a draft 404s publicly (see GET /public/:slug) but stays editable in admin
  showInNav Boolean  @default(false)
  navLabel  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Editable title/URL/publish-status for the 6 fixed pages THEMSELVES (not a
// duplicate - see FixedPageDuplicate above). These pages have hardcoded
// React routes (App.tsx: path="ausbildung" etc.) that the site's Header/
// Footer nav link to directly, so `slug` here is only ever consulted for a
// RENAME: if it differs from the kind's own hardcoded default, the old
// hardcoded route redirects to it (see FixedPageGate.tsx) and the new slug
// is picked up by the ":slug" catch-all (FixedPageRouter.tsx) - the old
// route, and every Header/Footer link and sub-route under it, keeps working
// without being touched. `slug` is null (and never editable) for "home",
// since the homepage always stays at "/". `status: "draft"` hides the page
// behind a "Diese Seite existiert nicht" message at both its old and new
// URL without touching the route itself. See fixedPageSettings.routes.ts.
model FixedPageSettings {
  id        String   @id @default(uuid())
  kind      String   @unique // home | ausbildung | performance | reisen | service | infos
  slug      String?  @unique
  title     String
  status    String   @default("published") // "published" | "draft"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Matches Joomla Visforms' real model: a form's fields are fully
// admin-configurable (add/remove/reorder/retype any field, not just the
// ones the code happened to ship with), and each submission stores
// whatever the form asked for at the time - hence the flexible `data`
// blob here instead of one fixed column per field. Confirmed zero real
// submissions existed on either environment before this change, so no
// migration of old fixed-column data was needed.
model FormConfig {
  id          String   @id // e.g. "service-auftrag" - doubles as the form's URL slug (/service/:id)
  title       String
  fields      Json     // FormFieldDef[] - see backend/src/routes/formconfigs.routes.ts
  // Old's real "Einleitungstext" (Formular bearbeiten > Allgemein tab) -
  // rich HTML shown above the field list on the public form page, not
  // just a plain description.
  introText   String?  @db.Text
  // Old's real Ergebnis/E-Mail Optionen/Spamschutz/Erweitert/Datenanzeige-im-
  // Frontend tab settings (visform.xml, deep-verified against fs-hirondelle.de's
  // real admin) - one flexible JSON blob per form (FormSettings shape in
  // formconfigs.routes.ts) rather than dozens of columns, matching how
  // `fields` above is already stored.
  settings    Json?
  // Matches old Visforms' real "Formulare" list columns (administrator/
  // components/com_visforms/src/View/Visforms/HtmlView.php +
  // tmpl/visforms/default.php) - published/access/language/hits/author are
  // real columns on its own #__visforms table, not derived.
  published   Boolean  @default(true)
  accessLevel String   @default("Öffentlich") // old's real Joomla view-level system (#__viewlevels) - simplified to a plain label here, no ACL groups
  language    String   @default("Alle") // old's real Joomla multi-language association - this site has none, always "Alle" (All)
  hits        Int      @default(0) // incremented on every public form-page view, matches old's real behavior exactly
  createdBy   String?  // resolved admin display name at creation time, matches old's real "Autor" column
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceOrder {
  id        String   @id @default(uuid())
  formId    String   @default("service-auftrag")
  data      Json     // { [fieldId]: value } - shape follows FormConfig.fields at submission time
  // Matches old's real "Datenanzeige im Frontend" tab (frontend-details
  // fieldset) - submitter identity for the "meine Einträge"/own-records-only
  // view, the submitter's IP for the real (non-gated) "Display IP" column
  // toggle, and a per-record publish flag for the real (non-gated)
  // "autopublish" toggle.
  userId    String?
  ip        String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The small "name / address / phone / email" block at the bottom of the
// mobile header drawer (Header.tsx) - used to be hardcoded there; now
// admin-editable from Admin > Menü (header tab), see headerContact.routes.ts.
model HeaderContactInfo {
  id           String   @id @default("default")
  siteName     String   @default("Flugschule Hirondelle")
  addressLine1 String   @default("Weinheim, 69469,")
  addressLine2 String   @default("Deutschland")
  phone        String   @default("+49 6201 12345")
  email        String   @default("info@flugschule-hirondelle.de")
  updatedAt    DateTime @updatedAt
}

// Old Matukio's hiron_matukio_invoice_number (MatukioHelperInvoice::
// getInvoiceNumber(), invoice.php): a real, legally-sequential invoice
// number ("number/year", e.g. "247/2026") assigned once per booking and
// never recalculated after that. 6,734 real historical rows (2013-2026)
// were migrated here exactly as old had them (matched via
// Booking.customerDetails.oldBookingId, see
// backfill_invoice_numbers_2026-10-11.ts) - this table is NOT reseeded
// from scratch; new bookings get the next number for their creation year
// lazily assigned the first time an admin views the bookings list or an
// invoice PDF is generated (see getOrCreateInvoiceNumber in
// utils/invoiceNumber.ts), continuing the real historical sequence.
model InvoiceNumber {
  id        String   @id @default(uuid())
  bookingId String   @unique
  year      Int
  number    Int
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([year, number])
}

