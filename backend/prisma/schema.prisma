// NEW MODEL - lets an admin create an entirely new page from scratch (title,
// slug, description, header image, content) that becomes live at its own
// top-level URL with no code change, unlike PageGallery/PageMedia above
// which only make EXISTING hardcoded pages editable, edited via the Unlayer
// drag-and-drop editor (Admin > Seiten). This is the single flow for ALL
// dynamic page content, including the home page itself (slug "home",
// rendered at "/" - see App.tsx). See backend/src/routes/pages.routes.ts,
// frontend/src/admin/Pages.tsx and frontend/src/pages/DynamicPage.tsx. To
// revert: drop this model, delete pages.routes.ts, remove its mount in
// index.ts, and remove the trailing ":slug" route (and the index route) in
// frontend/src/App.tsx plus the "Seiten" nav/admin entries.
model Page {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  metaDescription String?
  headerImageUrl  String?
  body            String?  @db.LongText // rendered HTML (Unlayer's exportHtml output body) - what the public page actually renders
